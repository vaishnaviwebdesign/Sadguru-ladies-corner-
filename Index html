        white-space:nowrap;
    }

    .nav-icons{
        font-size:21px;
    }

    .hero{
        min-height:500px;
        padding:50px 20px;
    }

    .hero h1{
        font-size:48px;
    }

    .hero h2{
        font-size:18px;
        letter-spacing:3px;
    }

    .tagline{
        font-size:24px;
    }

    .categories{
        grid-template-columns:1fr 1fr;
        gap:12px;
    }

    .category-card img{
        height:130px;
    }

    .products{
        grid-template-columns:1fr 1fr;
        gap:10px;
    }

    .product-img img{
        height:145px;
    }

    .product h3{
        font-size:14px;
    }

    .why-grid{
        grid-template-columns:1fr;
    }

    .why-item{
        border-right:none;
        border-bottom:1px solid #dcbfd8;
    }

    .contact-grid{
        grid-template-columns:1fr;
    }

    .contact-box{
        border-right:none;
        border-bottom:1px solid rgba(255,255,255,.3);
        padding-bottom:20px;
    }

    footer{
        flex-direction:column;
        gap:10px;
        text-align:center;
    }
}
